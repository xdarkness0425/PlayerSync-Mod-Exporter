index 0000000..e7147c7
--- /dev/null
+++ b/PlayerSync/Services/SourceQualityExport/SourceQualityExportJob.cs
@@ -0,0 +1,301 @@
+using MareSynchronos.API.Dto.Files;
+using MareSynchronos.WebAPI.Files;
+using Microsoft.Extensions.Logging;
+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using System.Text.RegularExpressions;
+
+namespace MareSynchronos.Services.SourceQualityExport;
+
+/// <summary>What the export job needs from PlayerSync. Implemented by <see cref="SourceQualityExportService"/> over FileDownloadManager.</summary>
+public interface ISourceQualityFileSource
+{
+    /// <summary>File server metadata for the hashes (FileDownloadManager.GetFileInfoAsync).</summary>
+    Task<List<DownloadFileDto>> GetFileInfoAsync(List<string> hashes, CancellationToken ct);
+
+    /// <summary>Downloads the un-munged, still LZ4-wrapped file (FileDownloadManager.DownloadTransportFileAsync).</summary>
+    Task DownloadTransportFileAsync(DownloadFileDto file, string destinationPath, CancellationToken ct);
+
+    /// <summary>Paths of local copies PlayerSync already knows for the hash, read without validating (the index is not rewritten).</summary>
+    IEnumerable<string> FindLocalCopies(string hash);
+}
+
+public enum SourceQualityFileStatus
+{
+    Pending,
+
+    /// <summary>The original was already on this computer; <see cref="SourceQualityFileResult.Path"/> points to it (read only).</summary>
+    CachedOriginal,
+
+    /// <summary>The original was downloaded, decoded and SHA-1 verified into the export staging folder.</summary>
+    Downloaded,
+
+    /// <summary>Not part of the pair's current, permission-filtered character data. Never requested from the server.</summary>
+    NotPermitted,
+
+    /// <summary>The file server marked the file as forbidden.</summary>
+    Forbidden,
+
+    /// <summary>The file server no longer has the original.</summary>
+    NotOnServer,
+
+    /// <summary>The server request or download failed.</summary>
+    Unavailable,
+
+    /// <summary>The decoded bytes did not match the hash. Nothing was kept.</summary>
+    HashMismatch,
+
+    Failed,
+    Cancelled,
+}
+
+public sealed record SourceQualityFileRequest(string Hash, string Extension, string GamePath);
+
+public sealed record SourceQualityFileResult
+{
+    public required string Hash { get; init; }
+    public string GamePath { get; init; } = string.Empty;
+    public SourceQualityFileStatus Status { get; init; }
+
+    /// <summary>For <see cref="SourceQualityFileStatus.Downloaded"/> the staged file, for CachedOriginal the existing local copy.</summary>
+    public string? Path { get; init; }
+
+    public long Size { get; init; }
+
+    /// <summary>True only when the bytes at <see cref="Path"/> were hashed and equal <see cref="Hash"/>.</summary>
+    public bool Sha1Verified { get; init; }
+
+    public string? Message { get; init; }
+}
+
+public enum SourceQualityJobState
+{
+    Running,
+    Completed,
+    Cancelled,
+    Failed,
+}
+
+/// <summary>
+/// Gets the source-quality originals of one export into a staging folder the exporter owns. It always uses the original hash,
+/// never the server's compressed alternate (the <c>AlwaysSourceQuality</c> policy), reuses the server metadata request, the
+/// authenticated download with its slots, throttling and munge handling, and the LZ4 transport decoding of the normal
+/// download, and verifies the SHA-1 of every decoded file. It never writes to the cache or its index: files go only to
+/// <see cref="StagingDirectory"/>, and only files this job created are ever deleted (temporary files always; staged originals
+/// as well when the job is cancelled or fails).
+/// </summary>
+public sealed partial class SourceQualityExportJob
+{
+    public const int MaxParallelDownloads = 3;
+
+    private readonly ISourceQualityFileSource _source;
+    private readonly IReadOnlyList<SourceQualityFileRequest> _permitted;
+    private readonly ILogger? _logger;
+    private readonly ConcurrentDictionary<string, SourceQualityFileResult> _results = new(StringComparer.OrdinalIgnoreCase);
+    private readonly ConcurrentDictionary<string, byte> _createdFiles = new(StringComparer.Ordinal);
+
+    public SourceQualityExportJob(ISourceQualityFileSource source, string stagingDirectory,
+        IReadOnlyList<SourceQualityFileRequest> permitted, IEnumerable<string> notPermitted, ILogger? logger = null)
+    {
+        _source = source;
+        StagingDirectory = System.IO.Path.GetFullPath(stagingDirectory);
+        _logger = logger;
+        _permitted = permitted.Where(r => IsHash(r.Hash) && IsExtension(r.Extension))
+            .GroupBy(r => r.Hash, StringComparer.OrdinalIgnoreCase).Select(g => g.First()).ToList();
+        foreach (var r in permitted.Where(r => !IsHash(r.Hash) || !IsExtension(r.Extension)))
+            _results[r.Hash] = new SourceQualityFileResult { Hash = r.Hash, GamePath = r.GamePath, Status = SourceQualityFileStatus.Failed, Message = "Invalid hash or extension." };
+        foreach (var r in _permitted)
+            _results[r.Hash] = new SourceQualityFileResult { Hash = r.Hash, GamePath = r.GamePath, Status = SourceQualityFileStatus.Pending };
+        foreach (var h in notPermitted)
+            _results.TryAdd(h, new SourceQualityFileResult
+            {
+                Hash = h, Status = SourceQualityFileStatus.NotPermitted,
+                Message = "Not in this pair's current character data after PlayerSync's permission filters; not requested.",
+            });
+    }
+
+    public string StagingDirectory { get; }
+
+    public SourceQualityJobState State { get; private set; } = SourceQualityJobState.Running;
+
+    public string? Error { get; private set; }
+
+    public IReadOnlyList<SourceQualityFileResult> GetResults() => _results.Values.OrderBy(r => r.Hash, StringComparer.Ordinal).ToList();
+
+    public static bool IsHash(string hash) => HashPattern().IsMatch(hash);
+
+    public static bool IsExtension(string extension) => ExtensionPattern().IsMatch(extension);
+
+    public async Task RunAsync(CancellationToken ct)
+    {
+        try
+        {
+            if (!Directory.Exists(StagingDirectory))
+                throw new DirectoryNotFoundException("The export staging folder does not exist.");
+
+            var toDownload = new List<SourceQualityFileRequest>();
+            foreach (var request in _permitted)
+            {
+                ct.ThrowIfCancellationRequested();
+                if (await TryUseLocalCopyAsync(request, ct).ConfigureAwait(false) is { } local)
+                    _results[request.Hash] = local;
+                else
+                    toDownload.Add(request);
+            }
+
+            if (toDownload.Count > 0)
+            {
+                var infos = (await _source.GetFileInfoAsync(toDownload.Select(r => r.Hash.ToUpperInvariant()).ToList(), ct).ConfigureAwait(false))
+                    .GroupBy(d => d.Hash, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
+                await Parallel.ForEachAsync(toDownload, new ParallelOptions { MaxDegreeOfParallelism = MaxParallelDownloads, CancellationToken = ct },
+                    async (request, token) => _results[request.Hash] = await GetOriginalAsync(request, infos.GetValueOrDefault(request.Hash), token).ConfigureAwait(false))
+                    .ConfigureAwait(false);
+            }
+
+            State = SourceQualityJobState.Completed;
+        }
+        catch (OperationCanceledException)
+        {
+            Abort(SourceQualityJobState.Cancelled, null);
+        }
+        catch (Exception ex)
+        {
+            _logger?.LogWarning(ex, "Source-quality export failed");
+            Abort(SourceQualityJobState.Failed, ex.Message);
+        }
+    }
+
+    private void Abort(SourceQualityJobState state, string? error)
+    {
+        DeleteCreatedFiles();
+        foreach (var (hash, result) in _results)
+        {
+            if (result.Status is SourceQualityFileStatus.Pending or SourceQualityFileStatus.Downloaded)
+                _results[hash] = result with { Status = SourceQualityFileStatus.Cancelled, Path = null, Sha1Verified = false, Size = 0 };
+        }
+
+        Error = error;
+        State = state;
+    }
+
+    private async Task<SourceQualityFileResult?> TryUseLocalCopyAsync(SourceQualityFileRequest request, CancellationToken ct)
+    {
+        foreach (var path in _source.FindLocalCopies(request.Hash))
+        {
+            try
+            {
+                if (!File.Exists(path))
+                    continue;
+                // Read-only: the copy is hashed, never moved, rewritten or re-indexed.
+                var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 81920, useAsync: true);
+                await using var _ = stream.ConfigureAwait(false);
+                var hash = Convert.ToHexString(await SHA1.HashDataAsync(stream, ct).ConfigureAwait(false));
+                if (string.Equals(hash, request.Hash, StringComparison.OrdinalIgnoreCase))
+                    return new SourceQualityFileResult
+                    {
+                        Hash = request.Hash, GamePath = request.GamePath, Status = SourceQualityFileStatus.CachedOriginal,
+                        Path = path, Size = stream.Length, Sha1Verified = true,
+                    };
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                _logger?.LogDebug(ex, "Could not read local copy {path}", path);
+            }
+        }
+
+        return null;
+    }
+
+    private async Task<SourceQualityFileResult> GetOriginalAsync(SourceQualityFileRequest request, DownloadFileDto? info, CancellationToken ct)
+    {
+        SourceQualityFileResult Result(SourceQualityFileStatus status, string message)
+            => new() { Hash = request.Hash, GamePath = request.GamePath, Status = status, Message = message };
+
+        // The original's own entry is used even when CompressedAlternateFileDownload is set: AlwaysSourceQuality.
+        if (info == null)
+            return Result(SourceQualityFileStatus.Unavailable, "The file server returned no information for this file.");
+        if (info.IsForbidden)
+            return Result(SourceQualityFileStatus.Forbidden, "The file server forbids this file" + (string.IsNullOrEmpty(info.ForbiddenBy) ? "." : $" ({info.ForbiddenBy})."));
+        if (!info.FileExists || info.Size <= 0)
+            return Result(SourceQualityFileStatus.NotOnServer, "The file server no longer has the original file.");
+
+        var transportPath = StagedPath(request.Hash, "transport.tmp");
+        var decodedPath = StagedPath(request.Hash, request.Extension + ".tmp");
+        var finalPath = StagedPath(request.Hash, request.Extension);
+        try
+        {
+            _createdFiles[transportPath] = 0;
+            await _source.DownloadTransportFileAsync(info, transportPath, ct).ConfigureAwait(false);
+            if (!File.Exists(transportPath))
+                return Result(SourceQualityFileStatus.Unavailable, "The download did not complete (the server request failed).");
+
+            byte[] decoded;
+            try
+            {
+                decoded = TransportCodec.Decode(await File.ReadAllBytesAsync(transportPath, ct).ConfigureAwait(false));
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException and not IOException)
+            {
+                return Result(SourceQualityFileStatus.Failed, "The downloaded data could not be decoded: " + ex.Message);
+            }
+
+            if (!string.Equals(Convert.ToHexString(SHA1.HashData(decoded)), request.Hash, StringComparison.OrdinalIgnoreCase))
+                return Result(SourceQualityFileStatus.HashMismatch, "The downloaded file does not match its hash and was discarded.");
+
+            _createdFiles[decodedPath] = 0;
+            await File.WriteAllBytesAsync(decodedPath, decoded, ct).ConfigureAwait(false);
+            _createdFiles[finalPath] = 0;
+            File.Move(decodedPath, finalPath, overwrite: true);
+            _createdFiles.TryRemove(decodedPath, out _);
+            return new SourceQualityFileResult
+            {
+                Hash = request.Hash, GamePath = request.GamePath, Status = SourceQualityFileStatus.Downloaded,
+                Path = finalPath, Size = decoded.LongLength, Sha1Verified = true,
+            };
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            _logger?.LogWarning(ex, "Source-quality download of {hash} failed", request.Hash);
+            return Result(ex is InvalidDataException ? SourceQualityFileStatus.Unavailable : SourceQualityFileStatus.Failed, ex.Message);
+        }
+        finally
+        {
+            TryDelete(transportPath);
+            TryDelete(decodedPath);
+        }
+    }
+
+    private string StagedPath(string hash, string extension)
+        => System.IO.Path.Combine(StagingDirectory, hash.ToLowerInvariant() + "." + extension);
+
+    private void TryDelete(string path)
+    {
+        try
+        {
+            if (File.Exists(path))
+                File.Delete(path);
+            _createdFiles.TryRemove(path, out _);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            _logger?.LogDebug(ex, "Could not delete {path}", path);
+        }
+    }
+
+    /// <summary>Deletes every file this job created (and nothing else).</summary>
+    public void DeleteCreatedFiles()
+    {
+        foreach (var path in _createdFiles.Keys.ToList())
+            TryDelete(path);
+    }
+
+    [GeneratedRegex("^[0-9A-Fa-f]{40}$", RegexOptions.None, matchTimeoutMilliseconds: 100)]
+    private static partial Regex HashPattern();
+
+    [GeneratedRegex("^[A-Za-z0-9]{1,8}$", RegexOptions.None, matchTimeoutMilliseconds: 100)]
+    private static partial Regex ExtensionPattern();
+}
diff --git a/PlayerSync/Services/SourceQualityExport/SourceQualityExportService.cs b/PlayerSync/Services/SourceQualityExport/SourceQualityExportService.cs
new file mode 100644
index 0000000..a3ce718
--- /dev/null
+++ b/PlayerSync/Services/SourceQualityExport/SourceQualityExportService.cs
@@ -0,0 +1,263 @@
+using Dalamud.Plugin;
+using Dalamud.Plugin.Ipc;
+using MareSynchronos.API.Dto.Files;
+using MareSynchronos.FileCache;
+using MareSynchronos.Interop.Ipc;
+using MareSynchronos.MareConfiguration;
+using MareSynchronos.PlayerData.Factories;
+using MareSynchronos.PlayerData.Pairs;
+using MareSynchronos.WebAPI.Files;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Logging;
+using System.Collections.Concurrent;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace MareSynchronos.Services.SourceQualityExport;
+
+/// <summary>
+/// Export-scoped source-quality downloads for another plugin (the PlayerSync Mod Exporter), exposed over IPC.
+/// For one explicitly selected, visible, unpaused pair it fetches the original files behind that pair's current,
+/// permission-filtered character data into a staging folder the caller owns. It does not change the compression setting,
+/// the Override UIDs list, the pair's applied appearance, the cache or the cache index. See Services/SourceQualityExport/README.md.
+/// </summary>
+public sealed class SourceQualityExportService : IHostedService
+{
+    public const int ApiVersion = 1;
+    public const int MaxHashesPerRequest = 5000;
+    public const int MaxKeptRequests = 4;
+
+    private const string Prefix = "PlayerSync.SourceQualityExport.";
+
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        Converters = { new JsonStringEnumConverter() },
+    };
+
+    private readonly ILogger<SourceQualityExportService> _logger;
+    private readonly IDalamudPluginInterface _pi;
+    private readonly PairManager _pairManager;
+    private readonly FileCacheManager _fileCacheManager;
+    private readonly FileTransferOrchestrator _orchestrator;
+    private readonly FileDownloadManagerFactory _downloadManagerFactory;
+    private readonly MareConfigService _configService;
+    private readonly IpcManager _ipcManager;
+    private readonly ConcurrentDictionary<string, (SourceQualityExportJob Job, CancellationTokenSource Cts, Task Task)> _jobs = new(StringComparer.Ordinal);
+
+    private ICallGateProvider<int>? _apiVersion;
+    private ICallGateProvider<nint, string, List<string>, string>? _start;
+    private ICallGateProvider<string, string>? _status;
+    private ICallGateProvider<string, bool>? _cancel;
+
+    public SourceQualityExportService(ILogger<SourceQualityExportService> logger, IDalamudPluginInterface pi, PairManager pairManager,
+        FileCacheManager fileCacheManager, FileTransferOrchestrator orchestrator, FileDownloadManagerFactory downloadManagerFactory,
+        MareConfigService configService, IpcManager ipcManager)
+    {
+        _logger = logger;
+        _pi = pi;
+        _pairManager = pairManager;
+        _fileCacheManager = fileCacheManager;
+        _orchestrator = orchestrator;
+        _downloadManagerFactory = downloadManagerFactory;
+        _configService = configService;
+        _ipcManager = ipcManager;
+    }
+
+    public Task StartAsync(CancellationToken cancellationToken)
+    {
+        _apiVersion = _pi.GetIpcProvider<int>(Prefix + "GetApiVersion");
+        _apiVersion.RegisterFunc(() => ApiVersion);
+        _start = _pi.GetIpcProvider<nint, string, List<string>, string>(Prefix + "Start");
+        _start.RegisterFunc(Start);
+        _status = _pi.GetIpcProvider<string, string>(Prefix + "GetStatus");
+        _status.RegisterFunc(GetStatus);
+        _cancel = _pi.GetIpcProvider<string, bool>(Prefix + "Cancel");
+        _cancel.RegisterFunc(Cancel);
+        return Task.CompletedTask;
+    }
+
+    public async Task StopAsync(CancellationToken cancellationToken)
+    {
+        _apiVersion?.UnregisterFunc();
+        _start?.UnregisterFunc();
+        _status?.UnregisterFunc();
+        _cancel?.UnregisterFunc();
+        var running = _jobs.Values.ToList();
+        foreach (var (_, cts, _) in running)
+            cts.Cancel();
+        try
+        {
+            await Task.WhenAll(running.Select(r => r.Task)).WaitAsync(TimeSpan.FromSeconds(5), cancellationToken).ConfigureAwait(false);
+        }
+        catch (Exception ex) when (ex is TimeoutException or OperationCanceledException)
+        {
+            _logger.LogWarning("Source-quality export jobs did not stop in time");
+        }
+
+        foreach (var (job, cts, _) in running)
+        {
+            job.DeleteCreatedFiles();
+            cts.Dispose();
+        }
+
+        _jobs.Clear();
+    }
+
+    /// <summary>Called by the IPC on the framework thread. Returns {"requestId": ...} or {"error": ...}.</summary>
+    private string Start(nint address, string stagingDirectory, List<string> hashes)
+    {
+        try
+        {
+            var (job, error) = CreateJob(address, stagingDirectory, hashes, out var source);
+            if (job == null || source == null)
+                return JsonSerializer.Serialize(new StartResult(null, error), Json);
+
+            var id = Guid.NewGuid().ToString("N");
+            var cts = new CancellationTokenSource();
+            var task = Task.Run(async () =>
+            {
+                try
+                {
+                    await job.RunAsync(cts.Token).ConfigureAwait(false);
+                }
+                finally
+                {
+                    source.Dispose();
+                }
+            });
+            _jobs[id] = (job, cts, task);
+            TrimFinishedJobs();
+            return JsonSerializer.Serialize(new StartResult(id, null), Json);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Starting a source-quality export failed");
+            return JsonSerializer.Serialize(new StartResult(null, "PlayerSync could not start the request: " + ex.Message), Json);
+        }
+    }
+
+    private (SourceQualityExportJob? Job, string? Error) CreateJob(nint address, string stagingDirectory, List<string> hashes, out FileSource? source)
+    {
+        source = null;
+        if (hashes == null || hashes.Count == 0 || hashes.Count > MaxHashesPerRequest)
+            return (null, $"Request between 1 and {MaxHashesPerRequest} files.");
+        if (_jobs.Values.Any(j => j.Job.State == SourceQualityJobState.Running))
+            return (null, "Another source-quality export is still running.");
+        if (StagingError(stagingDirectory, _configService.Current.CacheFolder, _ipcManager.Penumbra.ModDirectory) is { } stagingError)
+            return (null, stagingError);
+        if (!_orchestrator.IsInitialized)
+            return (null, "PlayerSync is not connected to a file server.");
+
+        var pair = address == nint.Zero ? null : _pairManager.GetVisiblePairs().FirstOrDefault(p => p.Address == address);
+        if (pair == null)
+            return (null, "That character is not a visible PlayerSync pair.");
+        if (pair.IsPaused)
+            return (null, "That pair is paused.");
+        if (pair.GetSyncedCharacterDataCopy() is not { } data)
+            return (null, "PlayerSync has no character data for that pair.");
+
+        var (permitted, notPermitted) = SelectPermitted(data.FileReplacements.Values.SelectMany(v => v)
+            .Select(f => (f.Hash, f.FileSwapPath, f.GamePaths)), hashes);
+        _logger.LogInformation("Source-quality export requested for {count} file(s), {rejected} not permitted", permitted.Count, notPermitted.Count);
+        source = new FileSource(_downloadManagerFactory, _fileCacheManager);
+        return (new SourceQualityExportJob(source, stagingDirectory, permitted, notPermitted, _logger), null);
+    }
+
+    /// <summary>
+    /// Keeps only requested hashes that are file replacements (not swaps) in the pair's permission-filtered data, with the
+    /// extension and first game path PlayerSync itself uses when it stores the file.
+    /// </summary>
+    public static (List<SourceQualityFileRequest> Permitted, List<string> NotPermitted) SelectPermitted(
+        IEnumerable<(string Hash, string FileSwapPath, string[] GamePaths)> synced, IEnumerable<string> requested)
+    {
+        var byHash = new Dictionary<string, SourceQualityFileRequest>(StringComparer.OrdinalIgnoreCase);
+        foreach (var (hash, swap, gamePaths) in synced)
+        {
+            if (!string.IsNullOrEmpty(swap) || string.IsNullOrEmpty(hash) || gamePaths.Length == 0 || byHash.ContainsKey(hash))
+                continue;
+            byHash[hash] = new SourceQualityFileRequest(hash, gamePaths[0].Split(".")[^1].ToLowerInvariant(), gamePaths[0]);
+        }
+
+        var permitted = new List<SourceQualityFileRequest>();
+        var notPermitted = new List<string>();
+        foreach (var hash in requested.Distinct(StringComparer.OrdinalIgnoreCase))
+        {
+            if (byHash.TryGetValue(hash, out var request))
+                permitted.Add(request);
+            else
+                notPermitted.Add(hash);
+        }
+
+        return (permitted, notPermitted);
+    }
+
+    /// <summary>The staging folder must exist and be outside PlayerSync's cache and Penumbra's mod folder.</summary>
+    public static string? StagingError(string stagingDirectory, string? cacheFolder, string? penumbraDirectory)
+    {
+        if (string.IsNullOrWhiteSpace(stagingDirectory) || !Path.IsPathFullyQualified(stagingDirectory) || !Directory.Exists(stagingDirectory))
+            return "The staging folder must be an existing absolute path.";
+        var staging = Normalize(stagingDirectory);
+        foreach (var protectedRoot in new[] { cacheFolder, penumbraDirectory })
+        {
+            if (string.IsNullOrWhiteSpace(protectedRoot))
+                continue;
+            var root = Normalize(protectedRoot);
+            if (staging.StartsWith(root, StringComparison.OrdinalIgnoreCase) || root.StartsWith(staging, StringComparison.OrdinalIgnoreCase))
+                return "The staging folder must be outside PlayerSync's cache and Penumbra's mod folder.";
+        }
+
+        return null;
+
+        static string Normalize(string path)
+            => Path.GetFullPath(path).Replace('\\', '/').TrimEnd('/') + "/";
+    }
+
+    private string GetStatus(string requestId)
+    {
+        if (!_jobs.TryGetValue(requestId ?? string.Empty, out var entry))
+            return JsonSerializer.Serialize(new StatusResult("Unknown", "No such request.", []), Json);
+        return SerializeStatus(entry.Job);
+    }
+
+    /// <summary>The GetStatus reply: {"state", "error", "files": [{"hash", "gamePath", "status", "path", "size", "sha1Verified", "message"}]}.</summary>
+    public static string SerializeStatus(SourceQualityExportJob job)
+        => JsonSerializer.Serialize(new StatusResult(job.State.ToString(), job.Error, job.GetResults()), Json);
+
+    /// <summary>Cancels a running request (its files are deleted) and forgets it. A finished request's staged files stay for the caller.</summary>
+    private bool Cancel(string requestId)
+    {
+        if (!_jobs.TryRemove(requestId ?? string.Empty, out var entry))
+            return false;
+        entry.Cts.Cancel();
+        _ = entry.Task.ContinueWith(_ => entry.Cts.Dispose(), TaskScheduler.Default);
+        return true;
+    }
+
+    private void TrimFinishedJobs()
+    {
+        foreach (var id in _jobs.Where(j => j.Value.Job.State != SourceQualityJobState.Running).Select(j => j.Key).SkipLast(MaxKeptRequests).ToList())
+            if (_jobs.TryRemove(id, out var old))
+                old.Cts.Dispose();
+    }
+
+    private sealed record StartResult(string? RequestId, string? Error);
+
+    private sealed record StatusResult(string State, string? Error, IReadOnlyList<SourceQualityFileResult> Files);
+
+    /// <summary>A dedicated FileDownloadManager per job, so pair downloads (CurrentDownloads) are never affected.</summary>
+    private sealed class FileSource(FileDownloadManagerFactory factory, FileCacheManager cache) : ISourceQualityFileSource, IDisposable
+    {
+        private readonly FileDownloadManager _downloads = factory.Create();
+
+        public void Dispose() => _downloads.Dispose();
+
+        public Task<List<DownloadFileDto>> GetFileInfoAsync(List<string> hashes, CancellationToken ct) => _downloads.GetFileInfoAsync(hashes, ct);
+
+        public Task DownloadTransportFileAsync(DownloadFileDto file, string destinationPath, CancellationToken ct)
+            => _downloads.DownloadTransportFileAsync(file, destinationPath, ct);
+
+        public IEnumerable<string> FindLocalCopies(string hash)
+            => cache.GetAllFileCachesByHash(hash, ignoreCacheEntries: false, validate: false).Select(e => e.ResolvedFilepath).Where(p => !string.IsNullOrEmpty(p)).ToList();
+    }
+}
