<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Name>$(ExporterProjectName)</Name>
    <AssemblyName>PlayerSyncModExporter</AssemblyName>
    <Version>0.4.0.0</Version>
    <Author>xdarkness0425</Author>
    <Punchline>Export the locally cached mod files of a PlayerSync pair's appearance, with permission.</Punchline>
    <Description>Select a visible PlayerSync pair, review which of their synchronized mod files are available in your local PlayerSync cache, confirm you have permission, and export them as a Penumbra mod package (.pmp) with an integrity manifest.</Description>
    <Tags>playersync;penumbra;export;backup</Tags>
    <RepoUrl>https://github.com/xdarkness0425/playersync-mod-exporter</RepoUrl>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlayerSyncModExporter.Core\PlayerSyncModExporter.Core.csproj" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
  </ItemGroup>
</Project>
