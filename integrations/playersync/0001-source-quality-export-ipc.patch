+using K4os.Compression.LZ4.Legacy;
+using MareSynchronos.API.Dto.Files;
+using MareSynchronos.MareConfiguration.Configurations;
+using MareSynchronos.Services.SourceQualityExport;
+using MareSynchronos.WebAPI.Files;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace PlayerSync.SourceQualityExportTest;
+
+/// <summary>
+/// A fake file server and cache: behaves like FileDownloadManager.GetFileInfoAsync / DownloadTransportFileAsync, which write the
+/// un-munged but still LZ4-wrapped file, and like FileCacheManager.GetAllFileCachesByHash(validate: false).
+/// </summary>
+internal sealed class FakeSource : ISourceQualityFileSource
+{
+    public Dictionary<string, DownloadFileDto> Server { get; } = new(StringComparer.OrdinalIgnoreCase);
+    public Dictionary<string, byte[]> Transport { get; } = new(StringComparer.OrdinalIgnoreCase);
+    public Dictionary<string, List<string>> Local { get; } = new(StringComparer.OrdinalIgnoreCase);
+    public List<string> InfoRequests { get; } = [];
+    public List<string> Downloads { get; } = [];
+    public Func<DownloadFileDto, string, CancellationToken, Task>? OnDownload { get; set; }
+
+    public Task<List<DownloadFileDto>> GetFileInfoAsync(List<string> hashes, CancellationToken ct)
+    {
+        lock (InfoRequests)
+            InfoRequests.AddRange(hashes);
+        return Task.FromResult(hashes.Where(Server.ContainsKey).Select(h => Server[h]).ToList());
+    }
+
+    public async Task DownloadTransportFileAsync(DownloadFileDto file, string destinationPath, CancellationToken ct)
+    {
+        lock (Downloads)
+            Downloads.Add(file.Hash);
+        if (OnDownload != null)
+        {
+            await OnDownload(file, destinationPath, ct).ConfigureAwait(false);
+            return;
+        }
+
+        await File.WriteAllBytesAsync(destinationPath, Transport[file.Hash], ct).ConfigureAwait(false);
+    }
+
+    public IEnumerable<string> FindLocalCopies(string hash) => Local.GetValueOrDefault(hash) ?? [];
+}
+
+[TestClass]
+public sealed class SourceQualityExportTests : IDisposable
+{
+    private const string Diffuse = "chara/equipment/e6001/texture/v01_c0201e6001_top_d.tex";
+    private const string Normal = "chara/equipment/e6001/texture/v01_c0201e6001_top_n.tex";
+
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "ps-sq-tests-" + Guid.NewGuid().ToString("N"));
+    private readonly string _staging;
+    private readonly string _cache;
+    private readonly FakeSource _source = new();
+
+    public SourceQualityExportTests()
+    {
+        _staging = Directory.CreateDirectory(Path.Combine(_root, "export", ".psme-staging")).FullName;
+        _cache = Directory.CreateDirectory(Path.Combine(_root, "PlayerSyncCache")).FullName;
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            Directory.Delete(_root, recursive: true);
+        }
+        catch (IOException)
+        {
+            // best effort
+        }
+    }
+
+    private static byte[] Bytes(int length, int seed)
+    {
+        var b = new byte[length];
+        new Random(seed).NextBytes(b);
+        return b;
+    }
+
+    private static string Sha1(byte[] data) => Convert.ToHexString(SHA1.HashData(data));
+
+    /// <summary>Registers an original (with a compressed alternate on the server) and returns its bytes and hash.</summary>
+    private (byte[] Bytes, string Hash) ServerOriginal(int seed, bool withAlternate = true)
+    {
+        var bytes = Bytes(5000 + seed, seed);
+        var hash = Sha1(bytes);
+        var altBytes = Bytes(1000, seed + 1000);
+        var alt = new DownloadFileDto { Hash = Sha1(altBytes), Size = 1000, DirectDownloadUrl = "https://cdn.invalid/alt" };
+        _source.Server[hash] = new DownloadFileDto
+        {
+            Hash = hash, Size = bytes.Length, DirectDownloadUrl = "https://cdn.invalid/" + hash,
+            CompressedAlternateFileDownload = withAlternate ? alt : null,
+        };
+        _source.Transport[hash] = LZ4Wrapper.Wrap(bytes);
+        _source.Transport[alt.Hash] = LZ4Wrapper.Wrap(altBytes);
+        return (bytes, hash);
+    }
+
+    private SourceQualityExportJob Job(IEnumerable<SourceQualityFileRequest> permitted, IEnumerable<string>? notPermitted = null)
+        => new(_source, _staging, permitted.ToList(), notPermitted ?? []);
+
+    private static SourceQualityFileRequest Req(string hash, string gamePath = Diffuse) => new(hash, "tex", gamePath);
+
+    private Dictionary<string, (string Hash, DateTime Mtime)> Snapshot(string dir)
+        => Directory.GetFiles(dir, "*", SearchOption.AllDirectories)
+            .ToDictionary(f => f, f => (Sha1(File.ReadAllBytes(f)), File.GetLastWriteTimeUtc(f)));
+
+    [TestMethod]
+    public void NormalSynchronization_StillFollowsTheConfiguredPolicy()
+    {
+        Assert.IsFalse(FileDownloadManager.UsesCompressedAlternate(CompressedAlternateUsage.AlwaysSourceQuality));
+        Assert.IsTrue(FileDownloadManager.UsesCompressedAlternate(CompressedAlternateUsage.CompressedNewDownloads));
+        Assert.IsTrue(FileDownloadManager.UsesCompressedAlternate(CompressedAlternateUsage.AlwaysCompressed));
+    }
+
+    [TestMethod]
+    public async Task OriginalHashIsDownloaded_EvenThoughACompressedAlternateExists()
+    {
+        var (bytes, hash) = ServerOriginal(1);
+        var job = Job([Req(hash)]);
+        await job.RunAsync(CancellationToken.None);
+
+        Assert.AreEqual(SourceQualityJobState.Completed, job.State);
+        CollectionAssert.AreEqual(new[] { hash }, _source.Downloads);
+        var r = job.GetResults().Single();
+        Assert.AreEqual(SourceQualityFileStatus.Downloaded, r.Status);
+        Assert.IsTrue(r.Sha1Verified);
+        Assert.AreEqual(Path.Combine(_staging, hash.ToLowerInvariant() + ".tex"), r.Path);
+        CollectionAssert.AreEqual(bytes, File.ReadAllBytes(r.Path!));
+        CollectionAssert.AreEqual(new[] { r.Path }, Directory.GetFiles(_staging)); // no temporary files left
+    }
+
+    [TestMethod]
+    public void OnlyFilesInThePermissionFilteredData_ArePermitted_AndSwapsAreNever()
+    {
+        var synced = new[]
+        {
+            ("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "", new[] { Diffuse }),
+            ("BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "chara/other.tex", new[] { Normal }),
+        };
+        var (permitted, notPermitted) = SourceQualityExportService.SelectPermitted(synced,
+            ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC"]);
+
+        Assert.AreEqual(1, permitted.Count);
+        Assert.AreEqual(("tex", Diffuse), (permitted[0].Extension, permitted[0].GamePath));
+        CollectionAssert.AreEquivalent(new[] { "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC" }, notPermitted);
+    }
+
+    [TestMethod]
+    public async Task NotPermittedFiles_AreReported_AndNeverRequestedFromTheServer()
+    {
+        var (_, hash) = ServerOriginal(2);
+        var (_, filtered) = ServerOriginal(3);
+        var job = Job([Req(hash)], [filtered]);
+        await job.RunAsync(CancellationToken.None);
+
+        CollectionAssert.DoesNotContain(_source.InfoRequests, filtered);
+        CollectionAssert.DoesNotContain(_source.Downloads, filtered);
+        Assert.AreEqual(SourceQualityFileStatus.NotPermitted, job.GetResults().Single(r => r.Hash == filtered).Status);
+    }
+
+    [TestMethod]
+    public async Task ForbiddenFile_IsReported_AndNotDownloaded()
+    {
+        var (_, hash) = ServerOriginal(4);
+        _source.Server[hash].IsForbidden = true;
+        _source.Server[hash].ForbiddenBy = "server rules";
+        var job = Job([Req(hash)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var r = job.GetResults().Single();
+        Assert.AreEqual(SourceQualityFileStatus.Forbidden, r.Status);
+        StringAssert.Contains(r.Message, "server rules");
+        Assert.AreEqual(0, _source.Downloads.Count);
+        Assert.AreEqual(0, Directory.GetFiles(_staging).Length);
+    }
+
+    [TestMethod]
+    public async Task OriginalNoLongerOnTheServer_IsReported_NotReplacedByTheAlternate()
+    {
+        var (_, hash) = ServerOriginal(5);
+        _source.Server[hash].FileExists = false;
+        var unknown = Sha1(Bytes(10, 77)); // the server returns nothing for it
+        var job = Job([Req(hash), Req(unknown, Normal)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var byHash = job.GetResults().ToDictionary(r => r.Hash);
+        Assert.AreEqual(SourceQualityFileStatus.NotOnServer, byHash[hash].Status);
+        Assert.AreEqual(SourceQualityFileStatus.Unavailable, byHash[unknown].Status);
+        Assert.AreEqual(0, _source.Downloads.Count);
+    }
+
+    [TestMethod]
+    public async Task CachedOriginal_IsUsedReadOnly_WithoutAnyServerRequest()
+    {
+        var (bytes, hash) = ServerOriginal(6);
+        var cached = Path.Combine(_cache, hash.ToLowerInvariant() + ".tex");
+        await File.WriteAllBytesAsync(cached, bytes);
+        _source.Local[hash] = [cached];
+        var before = Snapshot(_cache);
+
+        var job = Job([Req(hash)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var r = job.GetResults().Single();
+        Assert.AreEqual((SourceQualityFileStatus.CachedOriginal, cached, true), (r.Status, r.Path, r.Sha1Verified));
+        Assert.AreEqual(0, _source.InfoRequests.Count);
+        CollectionAssert.AreEquivalent(before.ToList(), Snapshot(_cache).ToList());
+        Assert.AreEqual(0, Directory.GetFiles(_staging).Length);
+    }
+
+    [TestMethod]
+    public async Task CorruptLocalCopy_IsIgnoredAndLeftAlone_AndTheOriginalIsDownloaded()
+    {
+        var (bytes, hash) = ServerOriginal(7);
+        var corrupt = Path.Combine(_cache, hash.ToLowerInvariant() + ".tex");
+        await File.WriteAllBytesAsync(corrupt, Bytes(100, 8));
+        _source.Local[hash] = [corrupt, Path.Combine(_cache, "gone.tex")];
+        var before = Snapshot(_cache);
+
+        var job = Job([Req(hash)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var r = job.GetResults().Single();
+        Assert.AreEqual(SourceQualityFileStatus.Downloaded, r.Status);
+        CollectionAssert.AreEqual(bytes, File.ReadAllBytes(r.Path!));
+        CollectionAssert.AreEquivalent(before.ToList(), Snapshot(_cache).ToList()); // the cache is never repaired or rewritten
+    }
+
+    [TestMethod]
+    public void Unmunger_UndoesTheServerMunge_AcrossBufferBoundaries()
+    {
+        var plain = Bytes(1000, 9);
+        var key = Encoding.ASCII.GetBytes("k3y-of-odd-length");
+        var output = new List<byte>();
+        var unmunger = TransportCodec.CreateUnmunger("k3y-of-odd-length")!;
+        foreach (var chunk in plain.Select((b, i) => (byte)(b ^ key[i % key.Length])).Chunk(97))
+        {
+            unmunger.Apply(chunk);
+            output.AddRange(chunk);
+        }
+
+        CollectionAssert.AreEqual(plain, output.ToArray());
+        Assert.IsNull(TransportCodec.CreateUnmunger(null));
+        Assert.IsNull(TransportCodec.CreateUnmunger(""));
+    }
+
+    [TestMethod]
+    public void Decode_UnwrapsTheLz4TransportContainer()
+    {
+        var plain = Bytes(70000, 10);
+        CollectionAssert.AreEqual(plain, TransportCodec.Decode(LZ4Wrapper.Wrap(plain)));
+    }
+
+    [TestMethod]
+    public async Task WrongBytesFromTheServer_FailTheSha1Check_AndNothingIsKept()
+    {
+        var (_, hash) = ServerOriginal(11);
+        _source.Transport[hash] = LZ4Wrapper.Wrap(Bytes(5000, 12));
+        var job = Job([Req(hash)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var r = job.GetResults().Single();
+        Assert.AreEqual(SourceQualityFileStatus.HashMismatch, r.Status);
+        Assert.IsNull(r.Path);
+        Assert.AreEqual(0, Directory.GetFiles(_staging).Length);
+    }
+
+    [TestMethod]
+    public async Task UndecodableData_FailedRequest_AndServerErrors_AreReported_WithoutLeftovers()
+    {
+        var (_, garbage) = ServerOriginal(13);
+        _source.Transport[garbage] = Bytes(300, 14);
+        var (_, noFile) = ServerOriginal(15);
+        var (_, http) = ServerOriginal(16);
+        var (_, noUrl) = ServerOriginal(17);
+        _source.Server[noUrl].DirectDownloadUrl = null;
+        _source.OnDownload = async (file, path, ct) =>
+        {
+            if (file.Hash == noFile)
+                return; // DownloadFileThrottled returns without a file when the request fails
+            if (file.Hash == http)
+                throw new InvalidDataException("Http error NotFound");
+            if (string.IsNullOrEmpty(file.DirectDownloadUrl))
+                throw new InvalidDataException("The file server offered no download URL.");
+            await File.WriteAllBytesAsync(path, _source.Transport[file.Hash], ct);
+        };
+
+        var job = Job([Req(garbage), Req(noFile, Normal), Req(http, "a/b.tex"), Req(noUrl, "a/c.tex")]);
+        await job.RunAsync(CancellationToken.None);
+
+        var byHash = job.GetResults().ToDictionary(r => r.Hash);
+        Assert.AreEqual(SourceQualityJobState.Completed, job.State);
+        Assert.AreEqual(SourceQualityFileStatus.Failed, byHash[garbage].Status);
+        Assert.AreEqual(SourceQualityFileStatus.Unavailable, byHash[noFile].Status);
+        Assert.AreEqual(SourceQualityFileStatus.Unavailable, byHash[http].Status);
+        Assert.AreEqual(SourceQualityFileStatus.Unavailable, byHash[noUrl].Status);
+        Assert.AreEqual(0, Directory.GetFiles(_staging).Length);
+    }
+
+    [TestMethod]
+    public async Task Cancellation_DeletesEverythingTheJobCreated_AndNothingElse()
+    {
+        var (_, done) = ServerOriginal(18);
+        var (_, slow) = ServerOriginal(19);
+        var unrelated = Path.Combine(_staging, "exporter-owned.txt");
+        await File.WriteAllTextAsync(unrelated, "keep");
+        using var cts = new CancellationTokenSource();
+        var doneWritten = new TaskCompletionSource();
+        _source.OnDownload = async (file, path, ct) =>
+        {
+            await File.WriteAllBytesAsync(path, file.Hash == done ? _source.Transport[done] : [1, 2, 3], ct);
+            if (file.Hash == done)
+            {
+                doneWritten.TrySetResult();
+                return;
+            }
+
+            await doneWritten.Task;
+            await Task.Delay(50, ct);
+            cts.Cancel();
+            await Task.Delay(Timeout.Infinite, ct);
+        };
+
+        var job = new SourceQualityExportJob(_source, _staging, [Req(done), Req(slow, Normal)], []);
+        await job.RunAsync(cts.Token);
+
+        Assert.AreEqual(SourceQualityJobState.Cancelled, job.State);
+        CollectionAssert.AreEqual(new[] { unrelated }, Directory.GetFiles(_staging));
+        Assert.IsTrue(job.GetResults().All(r => r.Status == SourceQualityFileStatus.Cancelled && r.Path == null));
+    }
+
+    [TestMethod]
+    public async Task MissingStagingFolder_FailsTheJob_WithoutDownloading()
+    {
+        var (_, hash) = ServerOriginal(20);
+        var job = new SourceQualityExportJob(_source, Path.Combine(_root, "does-not-exist"), [Req(hash)], []);
+        await job.RunAsync(CancellationToken.None);
+        Assert.AreEqual(SourceQualityJobState.Failed, job.State);
+        Assert.AreEqual(0, _source.Downloads.Count);
+    }
+
+    [TestMethod]
+    public async Task InvalidHashOrExtension_IsRejected_AndNeverRequested()
+    {
+        var job = Job([new SourceQualityFileRequest("../../evil", "tex", Diffuse), new SourceQualityFileRequest(Sha1(Bytes(5, 1)), "t/x", Diffuse)]);
+        await job.RunAsync(CancellationToken.None);
+        Assert.IsTrue(job.GetResults().All(r => r.Status == SourceQualityFileStatus.Failed));
+        Assert.AreEqual(0, _source.InfoRequests.Count);
+    }
+
+    [TestMethod]
+    public async Task NoFileIsEverWrittenOutsideTheStagingFolder()
+    {
+        var cached = Path.Combine(_cache, "existing.tex");
+        await File.WriteAllBytesAsync(cached, Bytes(50, 21));
+        var outside = Directory.GetFiles(_root, "*", SearchOption.AllDirectories).ToHashSet();
+        var (_, a) = ServerOriginal(22);
+        var (_, b) = ServerOriginal(23);
+        _source.Transport[b] = LZ4Wrapper.Wrap(Bytes(10, 24)); // mismatch
+
+        var job = Job([Req(a), Req(b, Normal)]);
+        await job.RunAsync(CancellationToken.None);
+
+        var created = Directory.GetFiles(_root, "*", SearchOption.AllDirectories).Where(f => !outside.Contains(f)).ToList();
+        Assert.IsTrue(created.All(f => Path.GetDirectoryName(f) == _staging), string.Join(", ", created));
+        Assert.AreEqual(1, created.Count);
+    }
+
+    [TestMethod]
+    public async Task StatusJson_HasTheDocumentedShape()
+    {
+        var (_, hash) = ServerOriginal(25);
+        var job = Job([Req(hash)], ["DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"]);
+        await job.RunAsync(CancellationToken.None);
+        var json = SourceQualityExportService.SerializeStatus(job);
+
+        using var doc = System.Text.Json.JsonDocument.Parse(json);
+        Assert.AreEqual("Completed", doc.RootElement.GetProperty("state").GetString());
+        var files = doc.RootElement.GetProperty("files").EnumerateArray().ToList();
+        Assert.AreEqual(2, files.Count);
+        var downloaded = files.Single(f => f.GetProperty("hash").GetString() == hash);
+        Assert.AreEqual("Downloaded", downloaded.GetProperty("status").GetString());
+        Assert.IsTrue(downloaded.GetProperty("sha1Verified").GetBoolean());
+        Assert.AreEqual(Diffuse, downloaded.GetProperty("gamePath").GetString());
+        Assert.IsFalse(string.IsNullOrEmpty(downloaded.GetProperty("path").GetString()));
+        Assert.AreEqual("NotPermitted", files.Single(f => f.GetProperty("hash").GetString()!.StartsWith('D')).GetProperty("status").GetString());
+    }
+
+    [TestMethod]
+    public void StagingFolder_MustExist_AndBeOutsideTheCacheAndPenumbra()
+    {
+        var penumbra = Directory.CreateDirectory(Path.Combine(_root, "Penumbra")).FullName;
+        var inCache = Directory.CreateDirectory(Path.Combine(_cache, "sub")).FullName;
+        var inPenumbra = Directory.CreateDirectory(Path.Combine(penumbra, "sub")).FullName;
+
+        Assert.IsNull(SourceQualityExportService.StagingError(_staging, _cache, penumbra));
+        Assert.IsNotNull(SourceQualityExportService.StagingError(inCache, _cache, penumbra));
+        Assert.IsNotNull(SourceQualityExportService.StagingError(_cache, _cache, penumbra));
+        Assert.IsNotNull(SourceQualityExportService.StagingError(inPenumbra, _cache, penumbra));
+        Assert.IsNotNull(SourceQualityExportService.StagingError(_root, _cache, penumbra)); // contains the cache
+        Assert.IsNotNull(SourceQualityExportService.StagingError(Path.Combine(_root, "missing"), _cache, penumbra));
+        Assert.IsNotNull(SourceQualityExportService.StagingError("relative/path", _cache, penumbra));
+    }
+}
