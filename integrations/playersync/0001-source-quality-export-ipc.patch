diff --git a/PlayerSync/WebAPI/Files/TransportCodec.cs b/PlayerSync/WebAPI/Files/TransportCodec.cs
new file mode 100644
index 0000000..e863ebe
--- /dev/null
+++ b/PlayerSync/WebAPI/Files/TransportCodec.cs
@@ -0,0 +1,36 @@
+using K4os.Compression.LZ4.Legacy;
+using System.Text;
+
+namespace MareSynchronos.WebAPI.Files;
+
+/// <summary>
+/// The transport encoding of files served by the PlayerSync file server: the bytes are XOR "munged" with the file's
+/// <c>MungeKey</c> (undone while streaming) and LZ4-wrapped (<see cref="LZ4Wrapper"/>, undone after the download).
+/// Shared by the normal cache download and the export-scoped source-quality download.
+/// </summary>
+public static class TransportCodec
+{
+    /// <summary>Undoes the munge in place, continuing across buffers. Returns null when the file has no munge key.</summary>
+    public static Unmunger? CreateUnmunger(string? mungeKey)
+        => string.IsNullOrEmpty(mungeKey) ? null : new Unmunger(Encoding.ASCII.GetBytes(mungeKey));
+
+    /// <summary>Unwraps the LZ4 container of a fully downloaded (and un-munged) file.</summary>
+    public static byte[] Decode(byte[] wrapped) => LZ4Wrapper.Unwrap(wrapped);
+
+    public sealed class Unmunger
+    {
+        private readonly byte[] _key;
+        private long _offset;
+
+        internal Unmunger(byte[] key) => _key = key;
+
+        public void Apply(Span<byte> span)
+        {
+            for (int i = 0; i < span.Length; i++)
+            {
+                span[i] = (byte)(span[i] ^ _key[_offset]);
+                _offset = (_offset + 1) % _key.Length;
+            }
+        }
+    }
+}
